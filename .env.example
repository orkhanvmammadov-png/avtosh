# AVTOSH.AZ environment template — copy to .env.local and fill in real values.
# NEVER commit real secrets. .env* files (except this template) are git-ignored.

# ---------------------------------------------------------------------------
# Server-only variables (never expose to the browser, never NEXT_PUBLIC_*)
# All are OPTIONAL in Phase 4.1 — the app runs locally without them.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/avtosh

# Auth (Phase 4.4). OTP_PEPPER is REQUIRED for OTP login flows — a
# long random secret (>=16 chars, generate with `openssl rand -hex 32`).
# Rotating it invalidates live OTP challenges (5-minute artifacts) and
# resets IP rate-limit windows; sessions are unaffected.
# OTP_PEPPER=replace-with-a-long-random-secret
#
# Optional auth tuning (validated defaults shown):
# OTP_TTL_SECONDS=300
# OTP_RESEND_COOLDOWN_SECONDS=45
# OTP_MAX_ATTEMPTS=5
# OTP_MAX_RESENDS=3
# OTP_PHONE_MAX_PER_HOUR=5
# OTP_IP_MAX_PER_HOUR=10
# OTP_MIN_INTERVAL_SECONDS=45
# AUTH_SESSION_TTL_SECONDS=2592000
# AUTH_SESSION_COOKIE_NAME=avtosh_session
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# Listing image storage/processing (Phase 4.5; validated defaults shown):
# STORAGE_LISTING_UPLOADS_BUCKET=listing-uploads
# STORAGE_LISTING_IMAGES_BUCKET=listing-images
# LISTING_IMAGE_MAX_UPLOAD_BYTES=12582912
# LISTING_IMAGE_SIGNED_UPLOAD_TTL_SECONDS=300
# LISTING_IMAGE_SIGNED_READ_TTL_SECONDS=600
# LISTING_IMAGE_MAX_EDGE_PX=1600
# LISTING_IMAGE_WEBP_QUALITY=80
# LISTING_IMAGE_MAX_PENDING_UPLOADS=5
# WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
# WHATSAPP_WEBHOOK_SECRET=your-whatsapp-webhook-secret
# PAYMENT_API_KEY=your-payment-api-key
# PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret
# SENTRY_DSN_SERVER=https://example.ingest.sentry.io/project

# ---------------------------------------------------------------------------
# Kapital Bank e-commerce API (Phase 4.12). Server-only — NEVER
# NEXT_PUBLIC_*. Test environment: https://txpgtst.kapitalbank.az/api
# Production:                     https://e-commerce.kapitalbank.az/api
# Credentials come from the bank; never commit real values.
# KAPITAL_API_BASE_URL=https://txpgtst.kapitalbank.az/api
# KAPITAL_USERNAME=
# KAPITAL_PASSWORD=
# KAPITAL_TIMEOUT_MS=10000
# Extra allowed HPP hosts (comma-separated) if the bank serves the
# hosted page from a host other than the API host:
# KAPITAL_ALLOWED_HPP_HOSTS=

# Client-safe variables (must be prefixed NEXT_PUBLIC_, no secrets ever)
# ---------------------------------------------------------------------------
# Public canonical origin. REQUIRED in production: it becomes
# metadataBase for canonical/OG/Twitter URL resolution. Leaving it
# unset in a production build keeps Next's metadataBase warning as a
# deliberate reminder (localhost is never used as the production
# canonical origin).
# NEXT_PUBLIC_APP_URL=http://localhost:3000
#
# Anonymous contact-reveal abuse windows (Phase 4.9; validated defaults):
# CONTACT_REVEAL_PER_LISTING_PER_WINDOW=3
# CONTACT_REVEAL_PER_SOURCE_PER_WINDOW=15
# CONTACT_REVEAL_WINDOW_SECONDS=3600
