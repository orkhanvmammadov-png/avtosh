# AVTOSH.AZ environment template — copy to .env.local and fill in real values.
# NEVER commit real secrets. .env* files (except this template) are git-ignored.

# ---------------------------------------------------------------------------
# Server-only variables (never expose to the browser, never NEXT_PUBLIC_*)
# All are OPTIONAL in Phase 4.1 — the app runs locally without them.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/avtosh
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
# WHATSAPP_WEBHOOK_SECRET=your-whatsapp-webhook-secret
# PAYMENT_API_KEY=your-payment-api-key
# PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret
# SENTRY_DSN_SERVER=https://example.ingest.sentry.io/project

# ---------------------------------------------------------------------------
# Client-safe variables (must be prefixed NEXT_PUBLIC_, no secrets ever)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL=http://localhost:3000
